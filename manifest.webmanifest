{
  "name": "VERFORM COPILOT – Distinte treno",
  "short_name": "VERFORM",
  "description": "Distinte treno analizzate con Claude, da spuntare offline durante l'inserimento in Verform.",
  "lang": "it",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#05080b",
  "theme_color": "#05080b",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titolo",
      "text": "testo",
      "files": [
        { "name": "pacchetto", "accept": ["application/json", "text/plain", "application/octet-stream", ".json"] }
      ]
    }
  }
}
